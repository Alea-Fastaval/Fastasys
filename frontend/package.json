{
  "name": "fastasys",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "start": "ng serve --no-hmr --proxy-config proxy.conf.json",
    "start-hmr": "ng serve --proxy-config proxy.conf.json",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "test": "vitest --run --coverage",
    "test:watch": "vitest",
    "validate": "npm audit --audit-level=high",
    "format": "prettier --write \"src/**/*.{ts,js,json,css,scss,html,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,css,scss,html,md}\""
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.4",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=10"
  }
}
